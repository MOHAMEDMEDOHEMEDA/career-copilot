ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://career_copilot:career_copilot@localhost:5432/career_copilot
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=15
UPLOAD_LIMIT_PER_HOUR=20
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Optional paid-tier price assumptions in USD per million tokens; leave blank for unknown cost.
# GEMINI_INPUT_USD_PER_MILLION=0.10
# GEMINI_OUTPUT_USD_PER_MILLION=0.40
OLLAMA_ENABLED=true
OLLAMA_MODEL=llama3.2:latest
ANALYSIS_LIMIT_PER_HOUR=5
ADAPTIVE_INTERVIEW_LIMIT_PER_HOUR=30
ADAPTIVE_MAX_FOLLOWUPS=2
# Comma-separated source IDs reviewed for technical interview evaluation.
REVIEWED_TECHNICAL_SOURCE_IDS=
# Experimental hybrid retrieval; evaluate relevance before enabling.
KNOWLEDGE_HYBRID_ENABLED=false
KNOWLEDGE_VECTOR_MAX_DISTANCE=0.35
KNOWLEDGE_KEYWORD_MAX_DISTANCE=0.55
GOOGLE_SERVER_CLIENT_ID=
