<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSMicrophoneUsageDescription</key>
    <string>Career Copilot uses your microphone when you choose to dictate an interview answer.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Career Copilot converts your spoken interview answer into text for you to review and edit.</string>
    <key>GIDClientID</key>
    <string>$(GOOGLE_IOS_CLIENT_ID)</string>
    <key>GIDServerClientID</key>
    <string>$(GOOGLE_SERVER_CLIENT_ID)</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLSchemes</key>
            <array><string>$(GOOGLE_REVERSED_CLIENT_ID)</string></array>
        </dict>
    </array>
    <key>UILaunchScreen</key>
    <dict/>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
